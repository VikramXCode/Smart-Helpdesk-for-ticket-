# ── Database ──────────────────────────────────────────────────────────────────
# Neon PostgreSQL (pgvector enabled) or any Postgres 15+ instance
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/helpdesk

# ── Redis (Celery broker + result backend) ────────────────────────────────────
# Upstash Redis or local Redis
REDIS_URL=redis://localhost:6379/0

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=changeme-generate-a-real-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── AI APIs ───────────────────────────────────────────────────────────────────
# Groq: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# Jina AI: https://jina.ai/embeddings/
JINA_API_KEY=jina_your_jina_api_key_here
JINA_MODEL=jina-embeddings-v2-base-en
EMBEDDING_DIMENSION=768

# ── Notifications ─────────────────────────────────────────────────────────────
# Resend: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=helpdesk@yourdomain.com

# Twilio (optional — leave blank to mock SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Monitoring ────────────────────────────────────────────────────────────────
# Sentry (optional — leave blank to disable)
SENTRY_DSN=

# ── App Config ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# ── Trend Detection ───────────────────────────────────────────────────────────
TREND_MIN_CLUSTER_SIZE=3
TREND_LOOKBACK_HOURS=24
